                  "pm.test('Monthly points are 0 / 15', () => {",
                  "    pm.expect(body.monthlyRewards.map(m => m.month)).to.eql(['2026-08', '2026-09']);",
                  "    pm.expect(body.monthlyRewards.map(m => m.points)).to.eql([0, 15]);",
                  "});",
                  "pm.test('Total is 15', () => pm.expect(body.totalPoints).to.eql(15));"
                ]
              }
            }
          ]
        }
      ]
