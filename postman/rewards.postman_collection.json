                  "pm.test('Customer is Alice Johnson', () => pm.expect(body.customerName).to.eql('Alice Johnson'));",
                  "pm.test('Monthly points are 115 / 250 / 160', () => {",
                  "    pm.expect(body.monthlyRewards.map(m => m.points)).to.eql([115, 250, 160]);",
                  "});",
                  "pm.test('Total is 525', () => pm.expect(body.totalPoints).to.eql(525));"
                ]
              }
