    {
      "name": "Transactions",
      "description": "Add purchases and see them reflected in the rewards. Requests in the 'Add a purchase and check rewards' flow depend on each other, so run them in order. Data lives in memory: restart the app to get back to the seed data (the fixed totals checked in the Rewards folder assume seed data only).",
      "item": [
        {
          "name": "List transactions - all",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Every transaction shows the points it earned', () => {",
                  "    pm.response.json().forEach(t => pm.expect(t).to.have.property('points'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List transactions - one customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?customerId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "customerId",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Only Alice's transactions, oldest first', () => {",
                  "    body.forEach(t => pm.expect(t.customerId).to.eql(1));",
                  "    pm.expect(body[0].id).to.eql('T1001');",
                  "    pm.expect(body[0].points).to.eql(90);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Add a purchase and check rewards",
          "description": "1) read Eva's current rewards, 2) add a $120 purchase, 3) fetch it, 4) check Eva's rewards went up by 90. Safe to run repeatedly.",
          "item": [
            {
              "name": "1. Eva rewards - before",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/rewards/5",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "rewards",
                    "5"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const body = pm.response.json();",
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "const sep = body.monthlyRewards.find(m => m.month === '2026-09');",
                      "pm.collectionVariables.set('evaTotalBefore', body.totalPoints);",
                      "pm.collectionVariables.set('evaSeptemberBefore', sep ? sep.points : 0);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "2. Add $120 purchase for Eva",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/transactions",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "transactions"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"customerId\": 5,\n  \"amount\": 120.0,\n  \"date\": \"2026-09-20\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Creates a purchase. The id is generated, continuing the sample data's sequence (T1020, T1021, ...) and the response includes the points earned."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const body = pm.response.json();",
                      "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                      "pm.test('Location header points to the new transaction', () => {",
                      "    pm.expect(pm.response.headers.get('Location')).to.include('/api/transactions/' + body.id);",
                      "});",
                      "pm.test('$120 earns 90 points', () => pm.expect(body.points).to.eql(90));",
                      "pm.test('Customer name is filled in', () => pm.expect(body.customerName).to.eql('Eva Martinez'));",
                      "pm.collectionVariables.set('createdTransactionId', body.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "3. Get created transaction",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/transactions/{{createdTransactionId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "transactions",
                    "{{createdTransactionId}}"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('Returns the transaction just created', () => {",
                      "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('createdTransactionId'));",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "4. Eva rewards - after",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/rewards/5",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "rewards",
                    "5"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const body = pm.response.json();",
                      "const before = Number(pm.collectionVariables.get('evaTotalBefore'));",
                      "const sepBefore = Number(pm.collectionVariables.get('evaSeptemberBefore'));",
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('September went up by 90', () => {",
                      "    pm.expect(body.monthlyRewards.find(m => m.month === '2026-09').points).to.eql(sepBefore + 90);",
                      "});",
                      "pm.test('Total went up by 90', () => pm.expect(body.totalPoints).to.eql(before + 90));"
                    ]
                  }
                }
              ]
            }
          ]
        },
