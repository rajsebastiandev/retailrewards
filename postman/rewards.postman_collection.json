{
  "info": {
    "name": "Rewards",
    "description": "Requests for the Rewards running locally (`mvnw spring-boot:run`). Each request has test scripts that check the expected values for the seed data set; run the whole collection with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "createdTransactionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "evaTotalBefore",
      "value": "",
      "type": "string"
    },
    {
      "key": "evaSeptemberBefore",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Rewards",
      "item": [
        {
          "name": "All customers - full period",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rewards",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rewards"
              ]
            },
            "description": "Monthly and total points for every customer. With no dates, the period runs from the earliest to the latest transaction."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Period covers the whole data set', () => {",
                  "    pm.expect(body.from).to.eql('2026-07-03');",
                  "    pm.expect(body.to).to.eql('2026-09-30');",
                  "});",
                  "",
                  "pm.test('Total points per customer', () => {",
                  "    const totals = Object.fromEntries(body.customers.map(c => [c.customerName, c.totalPoints]));",
                  "    pm.expect(totals).to.eql({",
                  "        'Alice Johnson': 525,",
                  "        'Bob Smith': 652,",
                  "        'Carol Davis': 865,",
                  "        'David Lee': 220,",
                  "        'Eva Martinez': 0",
                  "    });",
                  "});",
                  "",
                  "pm.test('Every customer lists Jul, Aug and Sep', () => {",
                  "    body.customers.forEach(c => {",
                  "        pm.expect(c.monthlyRewards.map(m => m.month)).to.eql(['2026-07', '2026-08', '2026-09']);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "All customers - date range",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rewards?from=2026-08-01&to=2026-09-30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rewards"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-08-01",
                  "description": "Inclusive start date (yyyy-MM-dd)"
                },
                {
                  "key": "to",
                  "value": "2026-09-30",
                  "description": "Inclusive end date (yyyy-MM-dd)"
                }
              ]
            },
            "description": "Only transactions between `from` and `to` (both inclusive) are counted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Only Aug and Sep are listed', () => {",
                  "    body.customers.forEach(c => {",
                  "        pm.expect(c.monthlyRewards.map(m => m.month)).to.eql(['2026-08', '2026-09']);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Alice earns 410 points in Aug-Sep', () => {",
                  "    const alice = body.customers.find(c => c.customerId === 1);",
                  "    pm.expect(alice.totalPoints).to.eql(410);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Single customer - Alice (1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
